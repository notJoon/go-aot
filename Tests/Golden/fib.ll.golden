@.int_format = private unnamed_addr constant [6 x i8] c"%lld\0A\00"

declare i32 @printf(ptr, ...)

define internal i64 @go_fib(i64 %arg0) {
bb0:
  %v0 = icmp slt i64 %arg0, 2
  br i1 %v0, label %bb1, label %bb2

bb1:
  ret i64 %arg0

bb2:
  %v1 = sub i64 %arg0, 1
  %v2 = call i64 @go_fib(i64 %v1)
  %v3 = sub i64 %arg0, 2
  %v4 = call i64 @go_fib(i64 %v3)
  %v5 = add i64 %v2, %v4
  ret i64 %v5
}

define i32 @main() {
bb0:
  %v0 = call i64 @go_fib(i64 10)
  call i32 (ptr, ...) @printf(ptr @.int_format, i64 %v0)
  ret i32 0
}
