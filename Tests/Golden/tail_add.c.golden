#include <stdint.h>
#include <stdio.h>

static int64_t go_bump(int64_t go_n);
static int64_t go_sum(int64_t go_n);

static int64_t go_bump(int64_t go_n) {
  int64_t go_tmp_0 = go_n + 1;
  return go_tmp_0;
}

static int64_t go_sum(int64_t go_n) {
  int64_t go_tmp_0 = go_n < 2;
  if (go_tmp_0) {
    int64_t go_tmp_1 = go_bump(go_n);
    return go_tmp_1;
  }
  int64_t go_tmp_2 = go_bump(go_n);
  int64_t go_tmp_3 = go_n - 1;
  int64_t go_tmp_4 = go_sum(go_tmp_3);
  int64_t go_tmp_5 = go_tmp_2 + go_tmp_4;
  return go_tmp_5;
}

int main(void) {
  int64_t go_tmp_0 = go_sum(5);
  printf("%lld\n", (long long)go_tmp_0);
  return 0;
}
